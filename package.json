{
  "name": "@roroko-tool/dsh-roroko-tool",
  "description": "洛洛可全家桶插件大包(agent 侧子插件 + client 设置页)",
  "version": "0.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preinject": {
      "types": "./lib/types/preinject.d.ts",
      "default": "./lib/preinject.js"
    },
    "./data": {
      "types": "./lib/types/data.d.ts",
      "default": "./lib/data.js"
    },
    "./warn": {
      "types": "./lib/types/warn.d.ts",
      "default": "./lib/warn.js"
    },
    "./client": "./client/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/preinject.js",
    "lib/data.js",
    "lib/warn.js",
    "client/client.js",
    "cordis.patch.yml",
    "src/**/*.ts"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  }
}
