{
  "name": "@roroko-tool/dsh-roroko-tool",
  "description": "洛洛可全家桶插件大包(空骨架,逐步迁入 roroko 系列 agent 侧插件)",
  "version": "0.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preinject": {
      "types": "./lib/types/preinject.d.ts",
      "default": "./lib/preinject.js"
    },
    "./data": {
      "types": "./lib/types/data.d.ts",
      "default": "./lib/data.js"
    },
    "./warn": {
      "types": "./lib/types/warn.d.ts",
      "default": "./lib/warn.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/preinject.js",
    "lib/data.js",
    "lib/warn.js",
    "src/**/*.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.6.0"
  }
}
